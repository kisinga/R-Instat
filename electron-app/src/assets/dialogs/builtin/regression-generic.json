    { "name": "modelName", "kind": "string", "label": "Model Name" },
    { "name": "showSummary", "kind": "boolean", "default": true, "label": "Show Summary", "group": "Output" },
    { "name": "showAnova", "kind": "boolean", "label": "Show ANOVA Table", "group": "Output" },
    { "name": "plotDiagnostics", "kind": "boolean", "label": "Plot Diagnostics", "group": "Output" }
  ],
  "retrievalHints": { "keywords": ["regression", "linear", "model", "predict", "lm", "anova"] },
